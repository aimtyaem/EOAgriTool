# Copy this file to .env for local development only.
# Never commit real keys. Configure these values as deployment-platform secrets.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_PREVIEW_API_VERSION=2024-06-01

# Cosmos DB (optional; conversation-history endpoints require these values)
AZURE_COSMOSDB_ACCOUNT=
AZURE_COSMOSDB_ACCOUNT_KEY=
AZURE_COSMOSDB_DATABASE=eoagritool
AZURE_COSMOSDB_CONVERSATIONS_CONTAINER=conversations

# Application
LOG_LEVEL=INFO
FLASK_DEBUG=false
PORT=8000
COSMOS_INIT_TIMEOUT_SECONDS=30
MAX_CONVERSATION_MESSAGES_FOR_TITLE=10
APP_USER_AGENT=EOAgriTool/AsyncAzureOpenAI/2.0.0
MS_DEFENDER_ENABLED=false

# Optional Azure Functions tool calling
AZURE_OPENAI_FUNCTION_CALL_AZURE_FUNCTIONS_ENABLED=false
AZURE_OPENAI_FUNCTION_CALL_AZURE_FUNCTIONS_TOOLS_BASE_URL=
AZURE_OPENAI_FUNCTION_CALL_AZURE_FUNCTIONS_TOOL_BASE_URL=
AZURE_OPENAI_FUNCTION_CALL_AZURE_FUNCTIONS_TOOLS_KEY=

# Optional external API
VTRACKER_API_URL=https://eoagritool-cwfzfndaazauawex.canadacentral-01.azurewebsites.net/vtracker_data.json
